# RStudio session/state
.Rproj.user/
.Rhistory
.Rhistory*
.RData
.RData*
.RDataTmp*
.Ruserdata

# Cached / downloaded Sleeper data (regenerated by the script)
*.rds
sleeperPlayers.json
sleeperPlayersSorted.json

# Stray default R graphics device output (from bare print() under Rscript)
Rplots.pdf

# Generated chart outputs (build artifacts; regenerate by running ddbmFF.R)
*.png

# Python instance: virtualenv, caches, secrets
fantasy-football-4-fun/venv/
__pycache__/
*.pyc
.pytest_cache/
*.pkl

# Local secrets (per-instance .env; commit only the .env.example templates)
.env

# Generated parity-harness output (regenerated by verify.py)
tools/parity/out_*.json

.scratch_charts/

# data/sources/nflverse/ and data/sources/sleeper_stats/ ARE committed now (like
# data/sources/adp/): the Render image is built from git, so ignoring them left
# a cold container with no cache and every first page view fetched live, which
# exceeded the 512MB instance. Only the half-written temp files stay ignored.
data/sources/**/*.tmp
# When each snapshot source was last refreshed (webapp/refresher.py).
data/sources/refresh_state.json
data/sources/refresh_state.json.tmp
