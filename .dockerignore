# Keep the build context small: the image only needs
# fantasy-football-4-fun/requirements.txt, fantasy-football-4-fun/repo_paths.py,
# fantasy-football-4-fun/sleepermetrics, fantasy-football-4-fun/webapp, and
# data/seasons/ (see Dockerfile). Anything not COPYed just slows the context
# upload, and secrets must never enter it.

# VCS / CI / editor
.git
.github
.vscode
.idea
*.code-workspace

# The R instance and its analytics artifacts (the site is Python-only)
r-analysis/
*.Rproj
.Rproj.user/
.RData
.RData*
.Rhistory
.Rhistory*
*.rds
sleeperPlayerData.rds

# Python build/venv/cache cruft
**/__pycache__/
*.py[cod]
fantasy-football-4-fun/venv/
venv/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
fantasy-football-4-fun/tests/

# Secrets and local config -- never bake these into an image
**/.env
**/.env.*
!**/*.env.example

# Agent / scratch / docs not needed at runtime
.claude/
scratchpad/
docs/references.txt

# OS junk
.DS_Store
Thumbs.db
